# Copy to .env to override compose defaults: cp .env.example .env
# The application reads ANIMEGEN_* values directly from its environment.

# Host port for the Gradio UI (container side is always 7860).
HOST_PORT=7860

# Choose the default image tier: best, balanced, or fast.
ANIMEGEN_MODEL__DEFAULT=balanced

# Optional Hugging Face read token for higher model-download rate limits.
# Create one at https://huggingface.co/settings/tokens and keep it in .env only.
HF_TOKEN=your_token_here

# Use an Ollama already running on the host instead of the bundled container.
# ANIMEGEN_OLLAMA__HOST=http://host.docker.internal:11434
